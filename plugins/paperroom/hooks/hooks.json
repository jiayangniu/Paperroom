{
  "description": "Paperroom: small edits pass; a new or mostly rewritten paragraph needs the author's sentence intents first.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/tex_gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.*paperroom__.*",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/tex_gate.py\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/tex_gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.*paperroom__(activate_project|open_writing_workspace)$",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/tex_gate.py\"", "timeout": 10 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/tex_gate.py\"", "timeout": 10 }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/tex_gate.py\"", "timeout": 10 }]
      }
    ]
  }
}
